# Default port for the NATS client (the service listens here regardless of the
# value, since it's baked into nats-server.conf; PORT is a Railway convention for
# the public domain target).
PORT=8222

# Client connection port (NATS protocol). Fixed in the baked config.
NATS_PORT=4222

# Monitor / HTTP API port (health + /jsz etc). Fixed in the baked config.
MONITOR_PORT=8222

# JetStream store directory (must stay on the /data volume).
JETSTREAM_STORE_DIR=/data

# Optional: NATS server log level (TRACE, DEBUG, INFO, WARN, ERROR, FATAL, LTRACe)
NATS_LOG_LEVEL=INFO

# Optional: cluster name (for multi-node NATS superclusters / routed clusters).
CLUSTER_NAME=railway

# Optional: cluster listening port (6222). Leave default unless changing topology.
CLUSTER_PORT=6222

# Optional: maximum number of concurrent connections (per NATS docs; empty = unlimited).
NATS_MAX_CONNECTIONS=

# Optional: JetStream memory store for ephemeral streams (comma-separated stream names).
# Leave empty to keep all JetStream data on the /data volume.
NATS_JS_MEMORY_STREAMS=

# Optional: comma-separated list of additional JetStream file-backed storage limits
# (e.g. max bytes per stream). Empty = NATS defaults.
NATS_JS_MAX_BYTES=
